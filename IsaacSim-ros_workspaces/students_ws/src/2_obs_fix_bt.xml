<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithDistanceReplanning">
        <DistanceController distance="0.5" global_frame="map" robot_base_frame="base-link">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap_Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </DistanceController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearGlobalConstmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <RecoveryFallback name="RecovertFallback">
        <GoalUpdated />
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingACtions">

          <ClearEntireCostmap name="ClearLocalConstmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>

          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <backup backup_dist="0.30" backup_speed="0.30" />
        </RoundRobin>
      </RecovertFallback>
    </BehaviorTree>
  </root>

  **특정 이동 거리마다 현재 이동경로를 확인

