<!--
  Navigate-to-pose tree with replanning, recovery, AND movable-obstacle handling.

  Normal operation is identical to the stock Nav2 tree: the global path is
  replanned at 1 Hz and FollowPath drives the robot along it.

  Movable-obstacle handling (added):
    * Perception runs OUTSIDE the tree: the `rgbd_obstacle_monitor` node loads a
      MovableObstacleDetector plugin (default: DepthThresholdDetector), consumes
      the RGB-D depth stream, and republishes two std_msgs/Bool signals:
        /movable_obstacle/detected  - a movable obstacle is blocking the robot
        /obstacle/present           - that obstacle is still there
    * IsMovableObstacleDetected subscribes to /movable_obstacle/detected. It goes
      SUCCESS only once the monitor confirms a movable blocker close in front
      (the detector's stop_distance is what makes this an "approach then stop").
    * When that happens the HandleMovableObstacle branch takes over the
      ReactiveFallback: FollowPath is halted and WaitForObstacleClearance holds
      the robot in place, staying RUNNING until /obstacle/present goes false (or
      its updates go stale).
    * While the robot waits, the RateController above keeps replanning, so once
      the obstacle is handled the path is refreshed and FollowPath resumes
      straight to the goal.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <ReactiveFallback name="FollowPathOrHandleMovableObstacle">
            <ReactiveSequence name="HandleMovableObstacle">
              <IsMovableObstacleDetected topic="/movable_obstacle/detected"
                                         message_timeout="2.0"/>
              <Inverter>
                <WaitForObstacleClearance topic="/obstacle/present"
                                          timeout="0.0"
                                          clear_on_stale="true"
                                          message_timeout="3.0"/>
              </Inverter>
            </ReactiveSequence>
            <FollowPath path="{path}" controller_id="FollowPath"/>
          </ReactiveFallback>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
