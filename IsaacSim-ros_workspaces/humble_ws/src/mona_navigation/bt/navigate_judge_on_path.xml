<!--
  Stock navigate_to_pose_w_replanning_and_recovery.xml plus: stop when the local costmap
  shows a non-static obstacle on the path, judge it once (JudgeObstacle), and hand the
  verdict to the recovery slot of NavigateRecovery (the pipeline fails with obstacle_verdict
  and obstacle_action on the blackboard). RecoveryDispatch then picks:
    - verdict none            -> stock recoveries (clearing / spin / wait / backup).
    - NO_CANDIDATE            -> no detour mark (face outside the FOV, or a lidar floor-hit phantom).
                                 First time per goal: ComputeSweepPoses look_pose, CreepToFace
                                 rotate_only (turn toward the obstacle), Wait 1.5 s (fresh
                                 PathObstacle and camera frame), clear the local costmap, re-judge.
                                 Second time: MarkObstacle on /mona/ignored_objects/add; the monitor
                                 skips that obstacle for ignore_ttl (30 s) or until the goal ends.
    - action PUSH_RECHECK     -> after a push, the object is still on the path. Short detour
                                 (path <= 1.5x + 3 m of the current path) -> mark it and go around;
                                 otherwise re-arm action PUSH and fall through to IsPush (push again).
    - action PUSH             -> Fallback PushOrDetour. Push: staging pose, plan + FollowPath, ArmPose
                                 P_PUSH, CreepToFace the face, CreepToFace 2 m beyond the face bounded
                                 by max_travel 1.0 (stall -> relabel FIXED), publish on
                                 /mona/pushed_objects/add, ArmPose P_HOME, clear the local costmap
                                 (blind-zone cells), BackUp 1.2 m, reset the verdict. Any failure -> PushFailedDetour
                                 (arm home, back up 1.0 m, MarkObstacle detour).
    - action SWEEP            -> Fallback SweepOrDetour. Sweep: ComputeSweepPoses, plan + FollowPath
                                 to the staging pose (general_goal_checker, CreepToFace corrects the rest), CreepToFace, SweepObstacle
                                 (/sweep), BackUp 1.0 m (lidar is blind < 1.0 m), clear the local
                                 costmap (stale cells inside the blind zone are never raytraced away),
                                 reset the verdict. If any step fails, SweepFailedDetour backs up
                                 0.5 m and falls through to the MarkObstacle detour.
  Per-object caps (push 2, sweep 2). Push count is checked first: PathObstacle.push_count
  (push_count port) 1 -> PUSH_RECHECK without judging; >= 2 -> FIXED / DETOUR. Sweep cap (2): after SweepObstacle the object is published on
  /mona/swept_objects/add; path_obstacle_monitor tracks it for the goal and puts the count in
  PathObstacle.sweep_count (sweep_count port). 0 -> JudgeObstacle as usual; 1 -> sweep again
  without judging; >= 2 -> FIXED / DETOUR. A tracked object that was pushed out of its original
  approach corridor is ignored by the monitor, so it does not trigger at all.
    - anything else (DETOUR, FIXED, ERROR)
                              -> MarkObstacle publishes a temporary global-costmap mark
                                 (obstacle_marks.py), wait for the 1 Hz global update, reset
                                 the verdict, and the retry replans around it.
  obstacle_verdict stays "none" when nothing is on the path, so the tree then behaves
  exactly like the stock one.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Root">
      <SetBlackboard output_key="obstacle_verdict" value="none"/>
      <SetBlackboard output_key="obstacle_action" value="none"/>
      <SetBlackboard output_key="no_candidate_retried" value="no"/>
      <RecoveryNode number_of_retries="6" name="NavigateRecovery">
        <PipelineSequence name="NavigateWithReplanning">
          <RateController hz="1.0">
            <RecoveryNode number_of_retries="1" name="ComputePathToPose">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </RecoveryNode>
          </RateController>
          <ReactiveFallback name="JudgeOrFollow">
            <Sequence name="JudgeObstacleOnPath">
              <PathObstacleDetected topic="/mona/path_obstacle" max_age="1.0" obstacle="{path_obstacle}" sweep_count="{obstacle_sweep_count}" push_count="{obstacle_push_count}"/>
              <SetBlackboard output_key="obstacle_verdict" value="judging"/>
              <SetBlackboard output_key="obstacle_action" value="none"/>
              <Fallback name="SweepCountDispatch">
                <BlackboardCheckString name="PushedOnce" value_A="{obstacle_push_count}" value_B="1" return_on_mismatch="FAILURE">
                  <Sequence name="PushRecheck">
                    <SetBlackboard output_key="obstacle_verdict" value="MOVABLE"/>
                    <SetBlackboard output_key="obstacle_action" value="PUSH_RECHECK"/>
                  </Sequence>
                </BlackboardCheckString>
                <Sequence name="PushCapReached">
                  <Inverter name="PushedBefore">
                    <BlackboardCheckString name="NeverPushed" value_A="{obstacle_push_count}" value_B="0" return_on_mismatch="FAILURE">
                      <AlwaysSuccess/>
                    </BlackboardCheckString>
                  </Inverter>
                  <SetBlackboard output_key="obstacle_verdict" value="FIXED"/>
                  <SetBlackboard output_key="obstacle_action" value="DETOUR"/>
                </Sequence>
                <BlackboardCheckString name="NeverSwept" value_A="{obstacle_sweep_count}" value_B="0" return_on_mismatch="FAILURE">
                  <ForceSuccess>
                    <JudgeObstacle server_name="/judge_obstacle" server_timeout="2000" obstacle="{path_obstacle}" verdict="{obstacle_verdict}" label="{obstacle_label}" pushable="{obstacle_pushable}" action="{obstacle_action}"/>
                  </ForceSuccess>
                </BlackboardCheckString>
                <BlackboardCheckString name="SweptOnce" value_A="{obstacle_sweep_count}" value_B="1" return_on_mismatch="FAILURE">
                  <Sequence name="SweepAgain">
                    <SetBlackboard output_key="obstacle_verdict" value="MOVABLE"/>
                    <SetBlackboard output_key="obstacle_action" value="SWEEP"/>
                  </Sequence>
                </BlackboardCheckString>
                <Sequence name="SweepCapReached">
                  <SetBlackboard output_key="obstacle_verdict" value="FIXED"/>
                  <SetBlackboard output_key="obstacle_action" value="DETOUR"/>
                </Sequence>
              </Fallback>
              <AlwaysFailure name="HandVerdictToRecovery"/>
            </Sequence>
            <BlackboardCheckString name="NoVerdictYet" value_A="{obstacle_verdict}" value_B="none" return_on_mismatch="FAILURE">
              <RecoveryNode number_of_retries="1" name="FollowPath">
                <FollowPath path="{path}" controller_id="FollowPath"/>
                <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
              </RecoveryNode>
            </BlackboardCheckString>
          </ReactiveFallback>
        </PipelineSequence>
        <Fallback name="RecoveryDispatch">
          <BlackboardCheckString name="RecoverOnlyWithoutVerdict" value_A="{obstacle_verdict}" value_B="none" return_on_mismatch="FAILURE">
            <ReactiveFallback name="RecoveryFallback">
              <GoalUpdated/>
              <RoundRobin name="RecoveryActions">
                <Sequence name="ClearingActions">
                  <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
                  <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
                </Sequence>
                <Spin spin_dist="1.57"/>
                <Wait wait_duration="5"/>
                <BackUp backup_dist="0.30" backup_speed="0.05"/>
              </RoundRobin>
            </ReactiveFallback>
          </BlackboardCheckString>
          <BlackboardCheckString name="NoCandidate" value_A="{obstacle_verdict}" value_B="NO_CANDIDATE" return_on_mismatch="FAILURE">
            <Fallback name="NoCandidateFirstOrIgnore">
            <BlackboardCheckString name="NoCandidateFirstTime" value_A="{no_candidate_retried}" value_B="no" return_on_mismatch="FAILURE">
              <Sequence name="RejudgeOnce">
                <SetBlackboard output_key="no_candidate_retried" value="yes"/>
                <ForceSuccess>
                  <Sequence name="TurnToObstacle">
                    <ComputeSweepPoses obstacle="{path_obstacle}" look_pose="{look_pose}"/>
                    <CreepToFace target="{look_pose}" rotate_only="true"/>
                  </Sequence>
                </ForceSuccess>
                <Wait wait_duration="1.5"/>
                <ClearEntireCostmap name="ClearLocalCostmap-Rejudge" service_name="local_costmap/clear_entirely_local_costmap"/>
                <SetBlackboard output_key="obstacle_verdict" value="none"/>
              </Sequence>
            </BlackboardCheckString>
              <Sequence name="IgnoreObstacle">
                <MarkObstacle obstacle="{path_obstacle}" topic="/mona/ignored_objects/add"/>
                <SetBlackboard output_key="obstacle_verdict" value="none"/>
                <SetBlackboard output_key="obstacle_action" value="none"/>
              </Sequence>
            </Fallback>
          </BlackboardCheckString>
          <BlackboardCheckString name="IsPushRecheck" value_A="{obstacle_action}" value_B="PUSH_RECHECK" return_on_mismatch="FAILURE">
            <Fallback name="PushRecheckDispatch">
              <Sequence name="GoAroundIfShort">
                <MarkObstacle obstacle="{path_obstacle}"/>
                <Wait wait_duration="2"/>
                <ComputePathToPose goal="{goal}" path="{detour_path}" planner_id="GridBased"/>
                <PathLengthWithin path="{detour_path}" reference="{path}" ratio="1.5" slack="3.0"/>
                <SetBlackboard output_key="obstacle_verdict" value="none"/>
                <SetBlackboard output_key="obstacle_action" value="none"/>
              </Sequence>
              <Sequence name="PushAgain">
                <MarkObstacle obstacle="{path_obstacle}" topic="/mona/obstacle_marks/remove"/>
                <Wait wait_duration="1"/>
                <SetBlackboard output_key="obstacle_action" value="PUSH"/>
                <AlwaysFailure name="FallThroughToIsPush"/>
              </Sequence>
            </Fallback>
          </BlackboardCheckString>
          <BlackboardCheckString name="IsPush" value_A="{obstacle_action}" value_B="PUSH" return_on_mismatch="FAILURE">
            <Fallback name="PushOrDetour">
              <Sequence name="Push">
                <ComputeSweepPoses obstacle="{path_obstacle}" staging_dist="1.1" face_dist="0.25" staging_pose="{push_staging}" face_pose="{push_face}"/>
                <ComputeSweepPoses obstacle="{path_obstacle}" staging_dist="1.1" face_dist="-2.0" staging_pose="{push_unused}" face_pose="{push_target}"/>
                <ComputePathToPose goal="{push_staging}" path="{push_path}" planner_id="GridBased"/>
                <FollowPath path="{push_path}" controller_id="FollowPath"/>
                <ArmPose positions="-0.0107379;-0.1043107;0.4747671;-0.4172428" move_time="2.0"/>
                <CreepToFace target="{push_face}" speed="0.05"/>
                <Fallback name="PushForward">
                  <CreepToFace target="{push_target}" speed="0.08" max_travel="1.0" stall_time="1.5" stall_ratio="0.3" timeout="40" result="{push_result}"/>
                  <Sequence name="PushStalled">
                    <BlackboardCheckString value_A="{push_result}" value_B="STALLED" return_on_mismatch="FAILURE">
                      <SetBlackboard output_key="obstacle_verdict" value="FIXED"/>
                    </BlackboardCheckString>
                    <AlwaysFailure name="PushStallFails"/>
                  </Sequence>
                </Fallback>
                <MarkObstacle obstacle="{path_obstacle}" topic="/mona/pushed_objects/add"/>
                <ArmPose positions="-0.0015339807878856412;-1.0461748973380072;1.0753205323078345;0.009203884727313847" move_time="2.0"/>
                <!-- clear BEFORE backing up: the pre-push object cells sit inside the lidar blind zone
                     (< 1.0 m) under the robot and never raytrace away, so BackUp saw a collision (s36g) -->
                <ClearEntireCostmap name="ClearLocalCostmap-AfterPush" service_name="local_costmap/clear_entirely_local_costmap"/>
                <BackUp backup_dist="1.2" backup_speed="0.1"/>
                <SetBlackboard output_key="obstacle_verdict" value="none"/>
                <SetBlackboard output_key="obstacle_action" value="none"/>
              </Sequence>
              <Sequence name="PushFailedDetour">
                <ForceSuccess>
                  <ArmPose positions="-0.0015339807878856412;-1.0461748973380072;1.0753205323078345;0.009203884727313847" move_time="2.0"/>
                </ForceSuccess>
                <ClearEntireCostmap name="ClearLocalCostmap-PushFailed-BeforeBackUp" service_name="local_costmap/clear_entirely_local_costmap"/>
                <BackUp backup_dist="1.0" backup_speed="0.1"/>
                <ClearEntireCostmap name="ClearLocalCostmap-PushFailed" service_name="local_costmap/clear_entirely_local_costmap"/>
                <MarkObstacle obstacle="{path_obstacle}"/>
                <Wait wait_duration="2"/>
                <SetBlackboard output_key="obstacle_verdict" value="none"/>
                <SetBlackboard output_key="obstacle_action" value="none"/>
              </Sequence>
            </Fallback>
          </BlackboardCheckString>
          <BlackboardCheckString name="IsSweep" value_A="{obstacle_action}" value_B="SWEEP" return_on_mismatch="FAILURE">
            <Fallback name="SweepOrDetour">
              <Sequence name="Sweep">
                <ComputeSweepPoses obstacle="{path_obstacle}" staging_pose="{sweep_staging}" face_pose="{sweep_face}"/>
                <ComputePathToPose goal="{sweep_staging}" path="{sweep_path}" planner_id="GridBased"/>
                <FollowPath path="{sweep_path}" controller_id="FollowPath"/>
                <CreepToFace target="{sweep_face}"/>
                <SweepObstacle action_name="/sweep" result_code="{sweep_result}"/>
                <MarkObstacle obstacle="{path_obstacle}" topic="/mona/swept_objects/add"/>
                <BackUp backup_dist="1.0" backup_speed="0.1"/>
                <ClearEntireCostmap name="ClearLocalCostmap-AfterSweep" service_name="local_costmap/clear_entirely_local_costmap"/>
                <SetBlackboard output_key="obstacle_verdict" value="none"/>
                <SetBlackboard output_key="obstacle_action" value="none"/>
              </Sequence>
              <Sequence name="SweepFailedDetour">
                <BackUp backup_dist="0.5" backup_speed="0.1"/>
                <MarkObstacle obstacle="{path_obstacle}"/>
                <Wait wait_duration="2"/>
                <SetBlackboard output_key="obstacle_verdict" value="none"/>
                <SetBlackboard output_key="obstacle_action" value="none"/>
              </Sequence>
            </Fallback>
          </BlackboardCheckString>
          <Sequence name="Detour">
            <Inverter name="NotPushSweepOrNoCandidate">
              <Fallback name="PushSweepOrNoCandidate">
                <BlackboardCheckString value_A="{obstacle_action}" value_B="PUSH" return_on_mismatch="FAILURE">
                  <AlwaysSuccess/>
                </BlackboardCheckString>
                <BlackboardCheckString value_A="{obstacle_action}" value_B="PUSH_RECHECK" return_on_mismatch="FAILURE">
                  <AlwaysSuccess/>
                </BlackboardCheckString>
                <BlackboardCheckString value_A="{obstacle_action}" value_B="SWEEP" return_on_mismatch="FAILURE">
                  <AlwaysSuccess/>
                </BlackboardCheckString>
                <BlackboardCheckString value_A="{obstacle_verdict}" value_B="NO_CANDIDATE" return_on_mismatch="FAILURE">
                  <AlwaysSuccess/>
                </BlackboardCheckString>
              </Fallback>
            </Inverter>
            <MarkObstacle obstacle="{path_obstacle}"/>
            <Wait wait_duration="2"/>
            <SetBlackboard output_key="obstacle_verdict" value="none"/>
            <SetBlackboard output_key="obstacle_action" value="none"/>
          </Sequence>
        </Fallback>
      </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>
