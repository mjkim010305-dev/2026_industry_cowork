<!--
  festa_demo's BT: self-contained copy of festa_bringup/bt/festa_l_course_nopick.xml
  (itself festa_l_course.xml WITHOUT the part, minus RearPickObject: the arm
  stays at P_HOME while driving). /sweep is this package's scripts/sweep_only.py
  (P_HOME -> sweep -> P_HOME, no rear place / re-pick). Tree as in the source
  file except the final approach: FinalApproachStop (map-frame box pose, stamped
  TF) is replaced by /visual_approach (scripts/visual_approach.py: camera image
  only, then a straight odometry creep). On the real robot (2026-10-01 R7-R9) the
  TF-based stop left the box up to 15 deg off the robot's heading and the sweep
  arc ran into the wall beside it.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Navigate">
      <SetBlackboard output_key="box_swept" value="false"/>
      <SetBlackboard output_key="goal_blocked" value="false"/>
      <RecoveryNode number_of_retries="6" name="NavigateRecovery">
        <PipelineSequence name="NavigateWithReplanning">
          <RateController hz="1.0">
            <Fallback name="PlanOrMarkBlocked">
              <Sequence name="PlanToGoal">
                <Timeout msec="3000">
                  <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
                </Timeout>
                <SetBlackboard output_key="goal_blocked" value="false"/>
              </Sequence>
              <SetBlackboard output_key="goal_blocked" value="true"/>
            </Fallback>
          </RateController>
          <ReactiveFallback name="SweepIfBlockedOrFollow">
            <ForceFailure>
              <BlackboardCheckString value_A="{box_swept}" value_B="false" return_on_mismatch="FAILURE">
                <Sequence name="HandleGreenBox">
                  <!-- festa_demo (2026-10-02, user: dynamic scenes - a box put back, a new box,
                       one right after a corner): enter only when the box is right in front, judged
                       from the image alone by scripts/box_on_path.py (within 1 m, within 0.20 m of
                       the centre line). No map pose, no "blocked" path, every box judged afresh. -->
                  <IsGreenBoxDetected name="IsBoxInFront" pose_topic="green_box/front"
                                      visible_topic="green_box/on_path" max_age="1.0"/>
                  <!-- festa_demo (2026-10-01, user: Nav2 and the approach mixed oddly): no Nav2 leg
                       to a 0.8 m standoff pose any more (it turned to that pose's yaw, then the
                       approach turned again). Entering this branch halts FollowPath (Nav2 stops
                       the base); wait 1 s standing still, then the camera approach takes over. -->
                  <Wait name="HandOverToApproach" wait_duration="1"/>
                  <!-- festa_demo (2026-10-02, user): one call does the whole box - /handle_box
                       (scripts/handle_box.py: camera approach -> arm sweep -> body push -> escape from a
                       wall, one result). It replaces four actions called one by one (/visual_approach,
                       /sweep, /push_through, /escape): lost accept replies between nodes, a node dying
                       on per-goal subscriptions (real R22) and a new process per sweep came from that split.
                       accept_timeout 15 s: under Pi load the accept reply took 4-5 s (R20b). At most 2
                       attempts, each only while the box is still in front (sim S24_R4); then stand
                       10 s unless the box is gone, and judge again (no latch). -->
                  <Fallback name="HandleOrGiveUp">
                    <RetryUntilSuccessful num_attempts="2">
                      <Sequence name="HandleBoxAttempt">
                        <IsGreenBoxDetected name="StillInFront" pose_topic="green_box/front"
                                            visible_topic="green_box/on_path" max_age="1.0"/>
                        <SweepObstacle name="HandleBox" action_name="/handle_box"
                                       server_timeout="5.0" accept_timeout="15.0" sweep_timeout="600.0"
                                       result_code="{handle_result}"/>
                      </Sequence>
                    </RetryUntilSuccessful>
                    <ForceFailure>
                      <Fallback name="GoneOrWait">
                        <Inverter>
                          <IsGreenBoxDetected name="BoxStillThere" pose_topic="green_box/front"
                                              visible_topic="green_box/on_path" max_age="1.0"/>
                        </Inverter>
                        <Wait name="WaitAfterGiveUp" wait_duration="10"/>
                      </Fallback>
                    </ForceFailure>
                  </Fallback>
                  <!-- festa_demo (2026-10-02): no box_swept latch any more - the next box (or the
                       same one put back) is handled again; a box swept aside is not in front. -->
                  <ClearEntireCostmap name="ClearLocalCostmap-Resume"
                                      service_name="local_costmap/clear_entirely_local_costmap"/>
                  <ClearEntireCostmap name="ClearGlobalCostmap-Resume"
                                      service_name="global_costmap/clear_entirely_global_costmap"/>
                </Sequence>
              </BlackboardCheckString>
            </ForceFailure>
            <Sequence name="FollowIfReachable">
              <BlackboardCheckString name="IsGoalReachable" value_A="{goal_blocked}" value_B="false"
                                     return_on_mismatch="FAILURE">
                <AlwaysSuccess/>
              </BlackboardCheckString>
              <RecoveryNode number_of_retries="1" name="FollowPath">
                <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="general_goal_checker"/>
                <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
              </RecoveryNode>
            </Sequence>
            <!-- festa_demo (2026-10-02, sim S25_V1): hold only when the planner marked the goal
                 blocked. A plain FollowPath failure (robot wedged) used to land here too; the
                 next tick restarted FollowPath and cancelled this wait, so the pipeline never
                 failed and Spin/BackUp never ran (stuck 10 min at a pillar). -->
            <BlackboardCheckString name="IsGoalBlocked" value_A="{goal_blocked}" value_B="true"
                                   return_on_mismatch="FAILURE">
              <Inverter name="HoldWhileBlocked">
                <Wait wait_duration="15"/>
              </Inverter>
            </BlackboardCheckString>
          </ReactiveFallback>
        </PipelineSequence>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <!-- festa_demo (2026-10-02, sim S25_V5): /escape first - inside 0.20 m of a wall BackUp and
               Spin fail at once ("Collision Ahead"). Then (sim S25_V1, S25_V4) BackUp. Both times the robot was
               wedged nose-first (pillar, inner corner of the L); clearing does not free it and a
               Spin hits the same wall. 0.15 m: the arm at P_REAR_CARRY sticks out behind the
               0.20 m footprint the behavior server checks. -->
          <RoundRobin name="RecoveryActions">
            <SweepObstacle name="Escape" action_name="/escape" server_timeout="5.0" accept_timeout="15.0"
                           sweep_timeout="30.0" result_code="{escape_result}"/>
            <BackUp backup_dist="0.15" backup_speed="0.05"/>
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <Spin spin_dist="3.14"/>
            <Wait wait_duration="5"/>
          </RoundRobin>
        </ReactiveFallback>
      </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>
