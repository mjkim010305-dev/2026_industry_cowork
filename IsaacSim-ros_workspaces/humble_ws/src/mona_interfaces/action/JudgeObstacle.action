# On-demand judgment of one path obstacle (server: vlm_movability_node).
# Goal: the obstacle geometry from path_obstacle_monitor (map frame).
mona_interfaces/PathObstacle obstacle
---
# Result
string MOVABLE=MOVABLE
string FIXED=FIXED
string NO_CANDIDATE=NO_CANDIDATE
string UNSURE=UNSURE            # calibrated p between movable_lo and movable_hi; the robot detours
string ERROR=ERROR

string verdict          # one of MOVABLE | FIXED | UNSURE | NO_CANDIDATE | ERROR
string label            # VLM object label (empty if none)
bool pushable           # depth size gate, independent of verdict
uint32 votes_n          # number of VLM votes taken (k)
uint32 votes_movable    # number of votes that said movable
float32 latency_s       # wall time from goal acceptance to result [s]
string detail           # reason or error string
# What the robot should do about it (S36 rule in the server, from verdict + mask size):
string PUSH=PUSH
string SWEEP=SWEEP
string DETOUR=DETOUR
string action           # PUSH | SWEEP | DETOUR (DETOUR for every non-MOVABLE verdict, and also for a MOVABLE that is narrow-but-tall, not pushable, or of degenerate size)
float32 width_m         # mask width from depth [m] (0 if no mask)
float32 height_m        # mask height from depth [m] (0 if no mask)
---
# Feedback (none)
