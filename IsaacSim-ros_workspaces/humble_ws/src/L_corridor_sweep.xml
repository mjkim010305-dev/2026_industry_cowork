<!--
  L_corridor green-box scenario with the manipulator-side /sweep action
  instead of the old Place -> PushObstacle -> FixedPickObject posture chain.

  MainTree = Sequence "PickThenNavigate":
    1. RearPickObject - runs ONCE per NavigateToPose goal, before driving:
       front pick -> lift -> side carry -> P_REAR_CARRY (port of
       turtlebot3_ws festa_action/rear_pick.py). P_REAR_CARRY is the start
       pose obstacle_clear_sequence.py checks for, so the sweep below can
       place/re-pick the carried object. If /joint_states already shows
       P_REAR_CARRY (already carrying, e.g. a new goal restarted the tree)
       it returns SUCCESS without moving, so the object is not dropped.
    2. SetBlackboard box_swept = "false" - reset once per goal.
    3. RecoveryNode(6) "NavigateRecovery" around ReactiveFallback
       "SweepGreenBoxOrNavigate", whose first child is re-checked every tick:
       (A) HandleGreenBox, gated by box_swept == "false" and wrapped in
           ForceFailure: IsGreenBoxDetected, ComputeGreenBoxApproachGoal
           (0.8 m standoff), plan and FollowPath to it, FinalApproachStop
           (0.55 m to box centre / 0.4 m scan range), then:
             Wait 1 s          - hold still in front of the obstacle so the
                                 base has fully settled before the arm moves
             SweepObstacle     - /sweep action: rear place -> sweep ->
                                 retreat -> rear re-pick (back at
                                 P_REAR_CARRY). SUCCESS only on
                                 result_code == "SUCCESS".
             box_swept = "true", clear both costmaps.
           ForceFailure turns the finished sweep into FAILURE, so the
           fallback moves straight on to (B) in the same tick and the robot
           replans to {goal} with the box out of the way.
       (B) NavigateWithReplanning: replan {path} to {goal} at 1 Hz and
           FollowPath on it.
       On failure: RoundRobin recovery (clear costmaps / Spin / Wait /
       BackUp), up to 6 retries.

  Why (A) sits outside the replanning PipelineSequence: the box blocks the
  corridor, so ComputePathToPose to {goal} keeps failing until the box is
  swept. Inside the PipelineSequence that failure halted the approach and
  the sweep itself (the arm kept moving while recovery spun the base). As
  the first child of the ReactiveFallback, (A) preempts (B) as soon as the
  box is detected and is never halted by a failed {goal} plan. Once (A) is
  RUNNING the Sequence resumes its running child, so a detection dropout
  mid-sweep does not interrupt it either.

  SweepObstacle failure (ERROR / STALL / no server / rejected / timeout):
  box_swept stays "false", (A) fails and (B) tries the plain route, which
  normally fails too while the box blocks the corridor; recovery then runs
  and the next retry approaches and sweeps again (bounded by the 6
  retries). On SAFETY_STOP the manipulator side leaves the arm where it
  stopped (no retreat) - check the arm before letting the robot drive on.

  Requires (manipulator side, see "sweep action 연동"; copy of the
  turtlebot3_ws scripts kept in this workspace):
    python3 src/festa_manipulation/festa_action/sweep_action_server.py
    (Isaac Sim: set the ROS parameter safety_monitor:=false, since there is
     no joint1 current topic there - XML comments cannot contain the
     double-dash, see the run notes for the exact command)
  and plugin_lib_names to include, besides the core nav2 BT nodes:
    custom_rear_pick_object_action_bt_node
    custom_sweep_obstacle_action_bt_node
    custom_is_green_box_detected_condition_bt_node
    custom_compute_green_box_approach_goal_action_bt_node
    custom_final_approach_stop_action_bt_node
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="PickThenNavigate">

      <RearPickObject arm_action_name="/arm_controller/follow_joint_trajectory"
                      gripper_action_name="/gripper_controller/gripper_cmd"
                      arm_joint_names="joint1;joint2;joint3;joint4"
                      joint_states_topic="/joint_states"
                      arm_move_time="4.0"
                      open_position="0.02501155674647538"
                      grasp_position="0.002"
                      max_effort="0.0002"
                      grasp_settle_time="1.0"
                      carry_tolerance="0.12"
                      joint_state_timeout="2.0"
                      server_timeout="5.0"
                      step_timeout="15.0"/>

      <SetBlackboard output_key="box_swept" value="false"/>

      <RecoveryNode number_of_retries="6" name="NavigateRecovery">
        <ReactiveFallback name="SweepGreenBoxOrNavigate">

          <ForceFailure>
            <BlackboardCheckString value_A="{box_swept}" value_B="false" return_on_mismatch="FAILURE">
              <Sequence name="HandleGreenBox">
                <IsGreenBoxDetected pose_topic="green_box/pose"
                                    visible_topic="green_box/detected"
                                    max_age="1.0"/>
                <ComputeGreenBoxApproachGoal pose_topic="green_box/pose"
                                             global_frame="map"
                                             robot_base_frame="base_link"
                                             standoff_distance="0.8"
                                             max_age="1.0"
                                             approach_goal="{approach_goal}"/>
                <RecoveryNode number_of_retries="1" name="ComputePathToGreenBox">
                  <ComputePathToPose goal="{approach_goal}" path="{approach_path}" planner_id="GridBased"/>
                  <ClearEntireCostmap name="ClearGlobalCostmap-GreenBox" service_name="global_costmap/clear_entirely_global_costmap"/>
                </RecoveryNode>
                <FollowPath path="{approach_path}" controller_id="FollowPath" goal_checker_id="general_goal_checker"/>
                <FinalApproachStop scan_topic="/scan"
                                   cmd_vel_topic="/cmd_vel"
                                   stop_distance="0.4"
                                   lidar_confirm_scans="3"
                                   approach_speed="0.15"
                                   front_half_angle="0.26"
                                   scan_loss_timeout="0.5"
                                   time_allowance="30.0"
                                   pose_topic="green_box/pose"
                                   global_frame="map"
                                   robot_base_frame="base_link"
                                   stop_center_distance="0.55"/>

                <Wait wait_duration="1"/>

                <SweepObstacle action_name="/sweep"
                               server_timeout="5.0"
                               accept_timeout="5.0"
                               sweep_timeout="120.0"
                               result_code="{sweep_result}"/>

                <SetBlackboard output_key="box_swept" value="true"/>
                <ClearEntireCostmap name="ClearLocalCostmap-Resume"
                                    service_name="local_costmap/clear_entirely_local_costmap"/>
                <ClearEntireCostmap name="ClearGlobalCostmap-Resume"
                                    service_name="global_costmap/clear_entirely_global_costmap"/>
              </Sequence>
            </BlackboardCheckString>
          </ForceFailure>

          <PipelineSequence name="NavigateWithReplanning">
            <RateController hz="1.0">
              <RecoveryNode number_of_retries="1" name="ComputePathToPose">
                <Timeout msec="3000">
                  <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
                </Timeout>
                <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
              </RecoveryNode>
            </RateController>
            <RecoveryNode number_of_retries="1" name="FollowPath">
              <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="general_goal_checker"/>
              <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
            </RecoveryNode>
          </PipelineSequence>

        </ReactiveFallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <Spin spin_dist="3.14"/>
            <Wait wait_duration="5"/>
            <BackUp backup_dist="0.30" backup_speed="0.05"/>
          </RoundRobin>
        </ReactiveFallback>
      </RecoveryNode>

    </Sequence>
  </BehaviorTree>
</root>
