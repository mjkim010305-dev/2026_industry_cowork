<!--
  Example BT for the AI Festa green-box scenario: one NavigateToPose goal,
  with the same navigation and green-box handling as ONE leg of final.xml
  (no shuttle loop, no bootstrap pick - those are final.xml only).

  Not loaded automatically - point a NavigateToPose goal's `behavior_tree`
  field at this file's absolute path to run it for that one goal:

    ros2 action send_goal /navigate_to_pose nav2_msgs/action/NavigateToPose \
      "{pose: {header: {frame_id: map}, \
               pose: {position: {x: 0.0, y: 0.0}, orientation: {w: 1.0}}}, \
        behavior_tree: '/path/to/green_box_approach_example.xml'}"

  MainTree = RecoveryNode(6) "NavigateRecovery":
    * PipelineSequence replans {path} to {goal} at 1 Hz (3 s planner
      timeout, one global-costmap clear + retry on failure).
    * ReactiveFallback "FollowPathOrHandleGreenBox":
        - HandleGreenBox:
            CaptureInitialPath latches the first {path} as {initial_path}
            (re-latches if the goal moves > 0.5 m).
            IsGreenBoxDetected gates the branch: green_box/detected is true
            AND green_box/pose is no older than 1 s (Lane P detector node).
            ComputeGreenBoxApproachGoal -> {approach_goal}, 0.8 m short of
            the box centre along robot->box, facing it.
            ComputePathToPose plans {approach_path} to it.
            ApproachThenResume: FollowPath to the standoff point,
            FinalApproachStop creeps in open-loop on /cmd_vel and stops at
            0.55 m robot-to-box-centre or 0.4 m forward /scan range,
            PlaceObject, PushObstacle (arm posture only - does NOT move the
            box by itself), FixedPickObject, then WaitForObstacleClearance
            holds until /obstacle/still_present goes false or 10 s pass,
            both costmaps are wiped and FollowPath resumes {initial_path}.
        - otherwise plain FollowPath on {path}.
    * On failure: RoundRobin recovery (clear costmaps / Spin / Wait /
      BackUp), up to 6 retries, then the goal fails.

  WaitForObstacleClearance timeout="10.0" is a stopgap: nothing publishes
  /obstacle/still_present yet (TODO: arm-side clearance event, false =
  cleared). green_box/detected cannot serve as that signal - at contact
  range the detector rejects the clipped blob and reports false with the
  box still in place.

  0.8 / 0.55 / 0.4 m assume a ~0.3 m box - re-set them for the real box.

  Requires plugin_lib_names to include (in addition to the core nav2
  planner/controller/costmap-clear/recovery BT nodes):
    custom_capture_initial_path_action_bt_node
    custom_is_green_box_detected_condition_bt_node
    custom_compute_green_box_approach_goal_action_bt_node
    custom_final_approach_stop_action_bt_node
    custom_place_object_action_bt_node
    custom_push_obstacle_action_bt_node
    custom_fixed_pick_object_action_bt_node
    custom_wait_for_obstacle_clearance_action_bt_node

  Topic names below are the contract-table defaults (Session 11); override
  per-leaf via the ports if a deployment's detector/robot uses different
  topics.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Timeout msec="3000">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            </Timeout>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <ReactiveFallback name="FollowPathOrHandleGreenBox">
            <Sequence name="HandleGreenBox">
              <CaptureInitialPath path="{path}" goal="{goal}"
                                  goal_change_threshold="0.5"
                                  initial_path="{initial_path}"/>
              <IsGreenBoxDetected pose_topic="green_box/pose"
                                  visible_topic="green_box/detected"
                                  max_age="1.0"/>
              <ComputeGreenBoxApproachGoal pose_topic="green_box/pose"
                                           global_frame="map"
                                           robot_base_frame="base_link"
                                           standoff_distance="0.8"
                                           max_age="1.0"
                                           approach_goal="{approach_goal}"/>
              <RecoveryNode number_of_retries="1" name="ComputePathToGreenBox">
                <ComputePathToPose goal="{approach_goal}" path="{approach_path}" planner_id="GridBased"/>
                <ClearEntireCostmap name="ClearGlobalCostmap-GreenBox" service_name="global_costmap/clear_entirely_global_costmap"/>
              </RecoveryNode>
              <Sequence name="ApproachThenResume">
                <FollowPath path="{approach_path}" controller_id="FollowPath"/>
                <FinalApproachStop scan_topic="/scan"
                                   cmd_vel_topic="/cmd_vel"
                                   stop_distance="0.4"
                                   approach_speed="0.15"
                                   front_half_angle="0.26"
                                   scan_loss_timeout="0.5"
                                   time_allowance="30.0"
                                   pose_topic="green_box/pose"
                                   global_frame="map"
                                   robot_base_frame="base_link"
                                   stop_center_distance="0.55"/>

                <PlaceObject arm_action_name="/arm_controller/follow_joint_trajectory"
                             gripper_action_name="/gripper_controller/gripper_cmd"
                             arm_joint_names="joint1;joint2;joint3;joint4"
                             arm_move_time="3.0"
                             open_position="0.02501155674647538"
                             max_effort="0.0002"
                             server_timeout="5.0"
                             step_timeout="15.0"
                             post_open_delay="1.0"/>

                <PushObstacle arm_action_name="/arm_controller/follow_joint_trajectory"
                              gripper_action_name="/gripper_controller/gripper_cmd"
                              arm_joint_names="joint1;joint2;joint3;joint4"
                              arm_move_time="3.0"
                              open_position="0.02501155674647538"
                              max_effort="0.0"
                              push_hold_time="1.0"
                              server_timeout="5.0"
                              step_timeout="15.0"/>

                <FixedPickObject arm_action_name="/arm_controller/follow_joint_trajectory"
                                 gripper_action_name="/gripper_controller/gripper_cmd"
                                 arm_joint_names="joint1;joint2;joint3;joint4"
                                 arm_move_time="3.0"
                                 open_position="0.02501155674647538"
                                 grasp_position="0.002"
                                 max_effort="0.0002"
                                 server_timeout="5.0"
                                 step_timeout="15.0"/>

                <WaitForObstacleClearance topic="/obstacle/still_present"
                                          timeout="10.0"
                                          clear_on_stale="true"
                                          message_timeout="3.0"/>
                <ClearEntireCostmap name="ClearLocalCostmap-Resume"
                                    service_name="local_costmap/clear_entirely_local_costmap"/>
                <ClearEntireCostmap name="ClearGlobalCostmap-Resume"
                                    service_name="global_costmap/clear_entirely_global_costmap"/>
                <FollowPath path="{initial_path}" controller_id="FollowPath"/>
              </Sequence>
            </Sequence>
            <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="general_goal_checker"/>
          </ReactiveFallback>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Spin spin_dist="3.14"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
